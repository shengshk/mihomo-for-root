# Five numeric cron fields. Keep expressions out of shell evaluation.
mfr_cron_valid() {
  printf '%s\n' "$1" | busybox awk '
    function number(s) { return s ~ /^[0-9]+$/ }
    function field(s,lo,hi, parts,n,i,p,q,k,a,b,step) {
      n=split(s,parts,","); if (!n) return 0
      for(i=1;i<=n;i++) {
        k=split(parts[i],p,"/"); if(k>2 || (k==2 && (!number(p[2]) || p[2]+0<1 || p[2]+0>hi-lo+1))) return 0
        if(p[1]=="*") continue
        k=split(p[1],q,"-"); if(k>2 || !number(q[1])) return 0
        a=q[1]+0; b=(k==2?q[2]+0:a)
        if(k==2 && !number(q[2])) return 0
        if(a<lo || a>hi || b<lo || b>hi || a>b) return 0
      }
      return 1
    }
    NR!=1 {bad=1}
    {if(NF!=5 || !field($1,0,59) || !field($2,0,23) || !field($3,1,31) || !field($4,1,12) || !field($5,0,6)) bad=1}
    END {exit(bad || NR!=1)}'
}
