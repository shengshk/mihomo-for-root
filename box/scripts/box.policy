#!/system/bin/sh
# This watcher deliberately outlives Mihomo and never changes Wi-Fi itself.
umask 077
scripts_dir="${0%/*}"
. /data/adb/box/settings.ini
. "$scripts_dir/apps.utils"
. "$scripts_dir/adg.utils"
adg_paths
policy_pid="$box_run_state/wifi-policy.pid"
paused_file="$box_run_state/wifi-paused"
intent_file="$manage_dir/service-intent"
mkdir -p "$manage_dir" "$box_run_state"

alive() {
  local p
  p=$(cat "$1" 2>/dev/null)
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null && grep -q "$2" "/proc/$p/cmdline" 2>/dev/null
}
live() { alive "$box_pid" /bin/mihomo; }

release() {
  if [ "${policy_lock:-false}" = true ]; then
    rm -f "$manage_dir/operation.lock/pid"
    rmdir "$manage_dir/operation.lock" 2>/dev/null
    policy_lock=false
    live && "$scripts_dir/box.dns" start >/dev/null 2>&1
  fi
  return 0
}

acquire() {
  [ "${MFR_POLICY_LOCK_HELD:-0}" != 1 ] || return 0
  local lock="$manage_dir/operation.lock" owner modified now
  if ! mkdir "$lock" 2>/dev/null; then
    owner=$(cat "$lock/pid" 2>/dev/null)
    case "$owner" in
      ''|*[!0-9]*)
        modified=$(stat -c %Y "$lock" 2>/dev/null); now=$(date +%s)
        [ -n "$modified" ] && [ $((now - modified)) -gt 30 ] || return 75 ;;
      *) kill -0 "$owner" 2>/dev/null && return 75 ;;
    esac
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || return 75
  fi
  printf '%s\n' "$$" > "$lock/pid"
  policy_lock=true
  "$scripts_dir/box.dns" stop >/dev/null 2>&1
}

reconcile() {
  local explicit="${1:-false}" wanted disabled=false running=false paused=false ssid matches=false decision
  . /data/adb/box/settings.ini
  wanted=$(cat "$intent_file" 2>/dev/null)
  if [ -z "$wanted" ]; then
    if live; then wanted=running; else wanted=stopped; fi
    printf '%s\n' "$wanted" > "$intent_file"
  fi
  [ ! -f /data/adb/modules/box_for_root/disable ] || disabled=true
  live && running=true
  [ ! -f "$paused_file" ] || paused=true
  if [ "$wanted" = running ] && [ "$disabled" = false ]; then
    ssid=$(mfr_current_ssid) || return 0
  else
    ssid=""
  fi
  mfr_wifi_matches "$ssid" && matches=true
  decision=$(mfr_policy_decision "$wanted" "$disabled" "$running" "$paused" "$matches" "$explicit")
  case "$decision" in
    stop|pause)
      if [ "$running" = true ] || { [ "$decision" = pause ] && [ "$paused" = false ]; }; then
        "$scripts_dir/box.iptables" disable > "$box_run/wifi-policy.log" 2>&1 || return 1
        "$scripts_dir/box.service" stop >> "$box_run/wifi-policy.log" 2>&1 || return 1
      fi
      if [ "$decision" = pause ]; then
        printf '%s\n' "$ssid" > "$paused_file"
        # The shared summary is refreshed after AGH finishes switching below.
      fi
      ;;
    start)
      if [ "$running" != true ]; then
        "$scripts_dir/box.service" restart > "$box_run/wifi-policy.log" 2>&1 || {
          "$scripts_dir/box.iptables" disable >> "$box_run/wifi-policy.log" 2>&1
          "$scripts_dir/box.service" stop >> "$box_run/wifi-policy.log" 2>&1
          return 1
        }
      fi
      rm -f "$paused_file"
      ;;
  esac
  [ "$wanted" != stopped ] || rm -f "$paused_file"
  [ ! -f "$scripts_dir/box.adg" ] || MFR_ADG_OPERATION=1 "$scripts_dir/box.adg" sync || return $?
  "$scripts_dir/box.service" describe >/dev/null 2>&1
  return 0
}

refresh_apps() {
  local signature previous
  live || return 0
  signature=$(mfr_apps_signature) || return 0
  previous=$(cat "$box_run_state/apps.applied" 2>/dev/null)
  [ "$signature" != "$previous" ] || return 0
  # A changed installed UID set needs a fresh TUN configuration. This never
  # starts a stopped or Wi-Fi-paused core, and shares the management lock.
  "$scripts_dir/box.service" restart > "$box_run/apps-refresh.log" 2>&1
}

# Read-only check: stable networks must not cycle the operation lock or DNS
# watcher. The actual decision is checked again by reconcile under the lock.
policy_pending() {
  local ssid="$1" wanted disabled=false running=false paused=false matches=false decision
  wanted=$(cat "$intent_file" 2>/dev/null)
  [ -n "$wanted" ] || return 0
  [ ! -f /data/adb/modules/box_for_root/disable ] || disabled=true
  live && running=true
  [ ! -f "$paused_file" ] || paused=true
  mfr_wifi_matches "$ssid" && matches=true
  decision=$(mfr_policy_decision "$wanted" "$disabled" "$running" "$paused" "$matches" false)
  case "$decision" in
    stop) return 0 ;;
    start) [ "$running" = false ] || [ "$paused" = true ]; return $? ;;
    pause) [ "$running" = true ] || [ "$paused" = false ] || [ "$ssid" != "$(cat "$paused_file" 2>/dev/null)" ]; return $? ;;
  esac
  [ "$wanted" = stopped ] && [ "$paused" = true ]
}

trap release EXIT
trap 'exit 0' INT TERM HUP
case "$1" in
  start)
    "$scripts_dir/box.http" start >/dev/null 2>&1
    "$scripts_dir/box.adg" sync >/dev/null 2>&1
    if ! alive "$policy_pid" box.policy; then
      nohup /system/bin/sh "$0" watch </dev/null >/dev/null 2>&1 &
    fi ;;
  stop) if alive "$policy_pid" box.policy; then kill "$(cat "$policy_pid")" 2>/dev/null; fi ;;
  watch)
    alive "$policy_pid" box.policy && exit 0
    printf '%s\n' "$$" > "$policy_pid"
    . "$scripts_dir/network.events"
    trap 'release; mfr_events_close; [ "$(cat "$policy_pid" 2>/dev/null)" != "$$" ] || rm -f "$policy_pid"' EXIT
    mfr_events_open policy || exit 1
    next_network=0
    network_event=true
    next_adg_retry=0
    packages_previous=""
    packages_applied=""
    while [ -d /data/adb/modules/box_for_root ]; do
      now=$(mfr_uptime)
      if [ "$network_event" = true ] || [ "$now" -ge "$next_network" ]; then
        . /data/adb/box/settings.ini
        mfr_events_ensure
        next_network=$((now + $(mfr_network_interval)))
        "$scripts_dir/box.adg" sync >/dev/null 2>&1
        current=$(mfr_current_ssid)
        observed=$?
        if [ "$observed" = 0 ] && policy_pending "$current"; then
          sleep 1
          confirmed=$(mfr_current_ssid)
          if [ "$?" = 0 ] && [ "$current" = "$confirmed" ] && acquire; then
            reconcile false
            release
          fi
        fi
      fi
      # PID/state checks are cheap; failed AGH recovery is bounded to 30 s.
      if [ "$now" -ge "$next_adg_retry" ] && adg_health_needed; then
        "$scripts_dir/box.adg" sync >/dev/null 2>&1
        next_adg_retry=$((now + 30))
      fi
      # Retain the cheap package-file check; query UIDs only after it changes.
      packages_current=$(stat -c '%i:%Y:%s' "$system_packages_file" 2>/dev/null)
      if [ -n "$packages_current" ] && [ "$packages_current" = "$packages_previous" ] && [ "$packages_current" != "$packages_applied" ] && live && acquire; then
        refresh_apps && packages_applied="$packages_current"
        release
      fi
      packages_previous="$packages_current"
      network_event=false
      mfr_events_wait 5 && network_event=true
    done ;;
  reconcile)
    acquire || exit $?
    reconcile "${2:-false}" ;;
  request-start|request-stop|toggle)
    request="$1"
    # Check the current network, not the watcher's possibly stale pause flag.
    # A skipped Action must leave intent, DNS watching and pause state alone.
    if [ "$request" = toggle ]; then
      ssid=$(mfr_current_ssid) || { echo '无法读取 Wi-Fi 状态' >&2; exit 1; }
      if mfr_wifi_matches "$ssid"; then echo '当前 Wi-Fi 下暂停代理'; exit 0; fi
    fi
    acquire || { echo '操作进行中' >&2; exit 1; }
    if [ "$request" = toggle ]; then
      . /data/adb/box/settings.ini
      [ ! -f /data/adb/modules/box_for_root/disable ] || { echo '模块未启用' >&2; exit 1; }
      ssid=$(mfr_current_ssid) || { echo '无法读取 Wi-Fi 状态' >&2; exit 1; }
      if mfr_wifi_matches "$ssid"; then echo '当前 Wi-Fi 下暂停代理'; exit 0; fi
      if live; then request=request-stop; else request=request-start; fi
    fi
    if [ "$request" = request-start ]; then
      printf 'running\n' > "$intent_file"
      reconcile true || { echo '启动失败' >&2; exit 1; }
    else
      printf 'stopped\n' > "$intent_file"
      "$scripts_dir/box.iptables" disable > "$box_run/wifi-policy.log" 2>&1 || exit 1
      "$scripts_dir/box.service" stop >> "$box_run/wifi-policy.log" 2>&1 || exit 1
      rm -f "$paused_file"
    fi
    if [ "$1" = toggle ]; then
      if [ "$request" = request-stop ]; then echo '已停止'
      elif live; then echo '已启动'
      elif [ -f "$paused_file" ]; then echo '当前 Wi-Fi 下暂停代理'
      else echo '启动失败' >&2; exit 1
      fi
    fi ;;
  boot)
    acquire || exit $?
    if [ "$boot_auto_start" != true ]; then
      printf 'stopped\n' > "$intent_file"
      rm -f "$paused_file"
      exit 0
    fi
    if [ ! -s "$intent_file" ]; then
      if [ "$boot_auto_start" = true ]; then printf 'running\n'; else printf 'stopped\n'; fi > "$intent_file"
    fi
    if [ "$boot_auto_start" = true ]; then reconcile true; fi ;;
  *) exit 1 ;;
esac
