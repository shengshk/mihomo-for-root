#!/system/bin/sh
# This watcher deliberately outlives Mihomo and never changes Wi-Fi itself.
umask 077
scripts_dir="${0%/*}"
. /data/adb/box/settings.ini
. "$scripts_dir/apps.utils"
. "$scripts_dir/adg.utils"
. "$scripts_dir/dns.utils"
. "$scripts_dir/status.utils"
adg_paths
policy_pid="$box_run_state/wifi-policy.pid"
paused_file="$box_run_state/wifi-paused"
intent_file="$manage_dir/service-intent"
mkdir -p "$manage_dir" "$box_run_state"

alive() {
  local p
  p=$(cat "$1" 2>/dev/null)
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null && grep -q "$2" "/proc/$p/cmdline" 2>/dev/null
}
live() { alive "$box_pid" /bin/mihomo; }

release() {
  mfr_transition_end
  if [ "${policy_lock:-false}" = true ]; then
    rm -f "$manage_dir/operation.lock/pid"
    rmdir "$manage_dir/operation.lock" 2>/dev/null
    policy_lock=false
    live && "$scripts_dir/box.dns" start >/dev/null 2>&1
  fi
  return 0
}

acquire() {
  [ "${MFR_POLICY_LOCK_HELD:-0}" != 1 ] || return 0
  local lock="$manage_dir/operation.lock" owner modified now
  if ! mkdir "$lock" 2>/dev/null; then
    owner=$(cat "$lock/pid" 2>/dev/null)
    case "$owner" in
      ''|*[!0-9]*)
        modified=$(stat -c %Y "$lock" 2>/dev/null); now=$(date +%s)
        [ -n "$modified" ] && [ $((now - modified)) -gt 30 ] || return 75 ;;
      *) kill -0 "$owner" 2>/dev/null && return 75 ;;
    esac
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null || return 75
  fi
  printf '%s\n' "$$" > "$lock/pid"
  policy_lock=true
  "$scripts_dir/box.dns" stop >/dev/null 2>&1
}

reconcile() {
  local explicit="${1:-false}" wanted disabled=false running=false paused=false ssid matches=false decision result synced=false
  . /data/adb/box/settings.ini
  wanted=$(cat "$intent_file" 2>/dev/null)
  if [ -z "$wanted" ]; then
    if live; then wanted=running; else wanted=stopped; fi
    printf '%s\n' "$wanted" > "$intent_file"
  fi
  [ ! -f /data/adb/modules/box_for_root/disable ] || disabled=true
  live && running=true
  [ ! -f "$paused_file" ] || paused=true
  if [ "$wanted" = running ] && [ "$disabled" = false ]; then
    ssid=$(mfr_current_ssid) || return 75
  else
    ssid=""
  fi
  mfr_wifi_matches "$ssid" && matches=true
  decision=$(mfr_policy_decision "$wanted" "$disabled" "$running" "$paused" "$matches" "$explicit")
  case "$decision" in
    stop|pause)
      if [ "$running" = true ] || { [ "$decision" = pause ] && [ "$paused" = false ]; }; then
        if [ "$decision" = pause ]; then
          mfr_transition_begin pausing || return 1
          mfr_action_progress '指定 Wi-Fi，正在暂停代理…'
        else mfr_transition_begin stopping || return 1; fi
        "$scripts_dir/box.service" stop > "$box_run/wifi-policy.log" 2>&1 || {
          if [ "$decision" = pause ]; then transition_failure=pause-error; else transition_failure=stop-error; fi
          return 1
        }
        synced=true
      fi
      if [ "$decision" = pause ]; then
        printf '%s\n' "$ssid" > "$paused_file"
        # The shared summary is refreshed after AGH finishes switching below.
      fi
      ;;
    start)
      if [ "$running" != true ]; then
        mfr_transition_begin starting || return 1
        mfr_action_progress '正在启动 Mihomo…'
        "$scripts_dir/box.service" start > "$box_run/wifi-policy.log" 2>&1
        result=$?
        case "$result" in
          0) ;;
          77) "$scripts_dir/box.service" describe >/dev/null 2>&1; return 0 ;;
          *) transition_failure=error; return "$result" ;;
        esac
        synced=true
      fi
      rm -f "$paused_file"
      ;;
  esac
  [ "$wanted" != stopped ] || rm -f "$paused_file"
  if [ "$synced" != true ]; then
    [ ! -f "$scripts_dir/box.adg" ] || adg_sync sync || return $?
  fi
  "$scripts_dir/box.service" describe >/dev/null 2>&1
  return 0
}

sync_adg_policy() {
  local result=0
  acquire || return 75
  adg_sync sync || result=$?
  release
  . /data/adb/box/settings.ini
  return "$result"
}

refresh_apps() {
  local signature previous
  live || return 0
  signature=$(mfr_apps_signature) || return 0
  previous=$(cat "$box_run_state/apps.applied" 2>/dev/null)
  [ "$signature" != "$previous" ] || return 0
  # A changed installed UID set needs a fresh TUN configuration. This never
  # starts a stopped or Wi-Fi-paused core, and shares the management lock.
  "$scripts_dir/box.service" restart > "$box_run/apps-refresh.log" 2>&1
}

# Read-only check: stable networks must not cycle the operation lock or DNS
# watcher. The actual decision is checked again by reconcile under the lock.
policy_pending() {
  local ssid="$1" wanted disabled=false running=false paused=false matches=false decision
  wanted=$(cat "$intent_file" 2>/dev/null)
  [ -n "$wanted" ] || return 0
  [ ! -f /data/adb/modules/box_for_root/disable ] || disabled=true
  live && running=true
  [ ! -f "$paused_file" ] || paused=true
  mfr_wifi_matches "$ssid" && matches=true
  decision=$(mfr_policy_decision "$wanted" "$disabled" "$running" "$paused" "$matches" false)
  case "$decision" in
    stop) return 0 ;;
    start) [ "$running" = false ] || [ "$paused" = true ]; return $? ;;
    pause) [ "$running" = true ] || [ "$paused" = false ] || [ "$ssid" != "$(cat "$paused_file" 2>/dev/null)" ]; return $? ;;
  esac
  [ "$wanted" = stopped ] && [ "$paused" = true ]
}

policy_check() {
  local current confirmed result
  policy_transition=false
  if [ "$(cat "$intent_file" 2>/dev/null)" = stopped ] || [ -f /data/adb/modules/box_for_root/disable ]; then
    current=''
  else
    current=$(mfr_current_ssid) || return 75
  fi
  policy_pending "$current" || return 0
  sleep 1
  if [ "$(cat "$intent_file" 2>/dev/null)" = stopped ] || [ -f /data/adb/modules/box_for_root/disable ]; then
    confirmed=''
  else
    confirmed=$(mfr_current_ssid) || return 75
  fi
  [ "$current" = "$confirmed" ] || return 75
  acquire || return 75
  policy_transition=true
  reconcile false
  result=$?
  release
  return "$result"
}

trap release EXIT
trap 'exit 0' INT TERM HUP
case "$1" in
  start)
    "$scripts_dir/box.http" start >/dev/null 2>&1
    if ! alive "$policy_pid" box.policy; then
      nohup "$scripts_dir/box.daemon" /system/bin/sh "$0" watch </dev/null >/dev/null 2>&1 &
    fi ;;
  stop) if alive "$policy_pid" box.policy; then kill "$(cat "$policy_pid")" 2>/dev/null; fi ;;
  watch)
    alive "$policy_pid" box.policy && exit 0
    printf '%s\n' "$$" > "$policy_pid"
    . "$scripts_dir/network.events"
    trap 'release; mfr_events_close; [ "$(cat "$policy_pid" 2>/dev/null)" != "$$" ] || rm -f "$policy_pid"' EXIT
    mfr_events_open policy || exit 1
    next_network=0
    next_retry=0
    retries=0
    network_event=true
    next_adg_retry=0
    last_network=''
    packages_previous=""
    packages_applied=""
    while [ -d /data/adb/modules/box_for_root ]; do
      now=$(mfr_uptime)
      if [ "$network_event" = true ]; then retries=5; next_retry=$now; fi
      if [ "$network_event" = true ] || [ "$now" -ge "$next_network" ] ||
         { [ "$retries" -gt 0 ] && [ "$now" -ge "$next_retry" ]; }; then
        . /data/adb/box/settings.ini
        mfr_events_ensure
        next_network=$((now + $(mfr_network_interval)))
        # Decisions have priority over AGH work. A short observation window also
        # covers Android state updates arriving after the last netlink event.
        policy_check
        result=$?
        now=$(mfr_uptime)
        if { [ "$policy_transition" = true ] && [ "$result" = 0 ]; } ||
           { [ "$result" != 0 ] && [ "$result" != 75 ]; }; then
          retries=0
        elif [ "$retries" -gt 0 ]; then retries=$((retries-1)); fi
        next_retry=$((now+2))
        network=$(dumpsys connectivity 2>/dev/null | box_dns_parse_network)
        if [ "$policy_transition" = true ] && [ "$result" = 0 ]; then
          last_network="$network"
        elif [ "$now" -ge "$next_adg_retry" ] &&
             { [ "$network" != "$last_network" ] || adg_health_needed; }; then
          sync_adg_policy >/dev/null 2>&1
          if [ "$?" = 0 ]; then last_network="$network"; else next_adg_retry=$((now+30)); fi
        fi
      fi
      if [ "$now" -ge "$next_adg_retry" ] && adg_health_needed; then
        sync_adg_policy >/dev/null 2>&1
        next_adg_retry=$((now+30))
      fi
      # Retain the cheap package-file check; query UIDs only after it changes.
      packages_current=$(stat -c '%i:%Y:%s' "$system_packages_file" 2>/dev/null)
      if [ -n "$packages_current" ] && [ "$packages_current" = "$packages_previous" ] && [ "$packages_current" != "$packages_applied" ] && live && acquire; then
        refresh_apps && packages_applied="$packages_current"
        release
      fi
      packages_previous="$packages_current"
      network_event=false
      wait_seconds=5
      [ "$retries" -le 0 ] || wait_seconds=2
      mfr_events_wait "$wait_seconds" && network_event=true
    done ;;
  adg-sync)
    sync_adg_policy ;;
  reconcile)
    acquire || exit $?
    reconcile "${2:-false}" ;;
  request-start|request-stop|toggle)
    request="$1"
    if [ "$request" = toggle ]; then
      exec 3>&1
      export MFR_ACTION_PROGRESS=1
    fi
    # Reject unknown network state before changing the user's intent.
    if [ "$request" = toggle ]; then
      ssid=$(mfr_current_ssid) || { mfr_action_error '无法读取 Wi-Fi 状态'; exit 1; }
    fi
    acquire || { mfr_action_error '操作进行中，请勿重复执行。'; exit 1; }
    if [ "$request" = toggle ]; then
      . /data/adb/box/settings.ini
      [ ! -f /data/adb/modules/box_for_root/disable ] || { mfr_action_error '模块未启用'; exit 1; }
      ssid=$(mfr_current_ssid) || { mfr_action_error '无法读取 Wi-Fi 状态'; exit 1; }
      # A paused core still has running intent. Toggle that intent, then let
      # reconcile enforce Wi-Fi policy instead of forcing the core to start.
      wanted=$(cat "$intent_file" 2>/dev/null)
      case "$wanted" in
        running|stopped) ;;
        *) if live; then wanted=running; else wanted=stopped; fi ;;
      esac
      if [ "$wanted" = running ]; then request=request-stop; else request=request-start; fi
    fi
    if [ "$request" = request-start ]; then
      printf 'running\n' > "$intent_file"
      reconcile true || { mfr_action_error '启用失败，请查看模块日志。'; exit 1; }
    else
      mfr_transition_begin stopping || exit 1
      mfr_action_progress '正在停止代理…'
      printf 'stopped\n' > "$intent_file"
      "$scripts_dir/box.service" stop > "$box_run/wifi-policy.log" 2>&1 || { transition_failure=stop-error; mfr_action_error '停止失败，请查看模块日志。'; exit 1; }
      rm -f "$paused_file"
    fi
    if [ "$1" = toggle ]; then
      if [ "$request" = request-stop ]; then echo '停止完成'
      elif live; then echo '启动完成'
      elif [ -f "$paused_file" ]; then echo '已暂停，离开指定 Wi-Fi 后恢复。'
      else mfr_action_error '启动失败'; exit 1
      fi
    fi ;;
  boot)
    acquire || exit $?
    if [ "$boot_auto_start" != true ]; then
      printf 'stopped\n' > "$intent_file"
      rm -f "$paused_file"
      exit 0
    fi
    if [ ! -s "$intent_file" ]; then
      if [ "$boot_auto_start" = true ]; then printf 'running\n'; else printf 'stopped\n'; fi > "$intent_file"
    fi
    if [ "$boot_auto_start" = true ]; then reconcile true; fi ;;
  *) exit 1 ;;
esac
